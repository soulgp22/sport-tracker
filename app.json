{
  "expo": {
    "name": "Life Sport Tracker",
    "slug": "sport-tracker",
    "version": "1.17.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sport-tracker",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ECE5D6",
    "ios": {
      "bundleIdentifier": "com.sportracker.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.sportracker.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#071A33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 33,
      "permissions": [
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A33",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 132
          }
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1677FF",
          "defaultChannel": "rest-timer-v3"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-camera",
        {
          "cameraPermission": "Life Sport Tracker utilise l'appareil photo pour scanner les codes-barres des aliments.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withHealthConnect.js",
      "./plugins/withCleanDomBundle.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise l'accès à ta galerie pour analyser la photo de ton repas.",
          "cameraPermission": "Autorise l'accès à l'appareil photo pour photographier ton repas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af38ec75-ab68-4fbe-9086-2f6655953ba9"
      }
    },
    "owner": "soulgp"
  }
}