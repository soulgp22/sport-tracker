# Modele de /etc/lst-quota.env (chmod 600, root). Valeurs FACTICES :
# le vrai fichier ne vit que sur le VPS, jamais dans le depot (public).

# Meme cle Bearer que meal-router et lst-catalog.
LST_API_KEY=replace-with-me

# Cle SECRETE RevenueCat (sk_...), onglet API keys du projet. Sans elle, tout
# le monde reste au palier gratuit (le service demarre quand meme).
REVENUECAT_SECRET_KEY=

# Identifiant du droit configure dans RevenueCat.
REVENUECAT_ENTITLEMENT=premium

# 1 = les versions de l'app anterieures au quota serveur passent (transition).
# Passer a 0 quand legacy_hits ne bouge plus.
LST_QUOTA_ALLOW_LEGACY=1

LST_QUOTA_DB=/opt/lst-quota/data/quota.db
LST_QUOTA_PORT=8354
